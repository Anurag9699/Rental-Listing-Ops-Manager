# ──────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# On Railway: set these in the Variables tab of your service.
# ──────────────────────────────────────────────────────────

# PostgreSQL connection string (provided by Railway Postgres plugin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Secret — use a long, random string in production (min 32 chars)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Internal URL of the Availability Engine service on Railway
# Format: https://<your-availability-engine>.up.railway.app/api/availability
AVAILABILITY_ENGINE_URL="http://localhost:3002/api/availability"
